# Firebase
firebase.json

# NLTK Data - Keep the data but exclude index files that can be regenerated
# The actual data files (zip and directories) should be committed
!nltk_data/
!nltk_data/**/*.zip
!nltk_data/**/
nltk_data/**/*.pyc
nltk_data/**/__pycache__/
